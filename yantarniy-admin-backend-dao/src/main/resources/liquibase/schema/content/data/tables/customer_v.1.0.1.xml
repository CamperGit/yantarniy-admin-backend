<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet id="customer_update_v.1.0.1_2024-08-08_22:22" author="dsashchenko">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="customer"/>
            <not>
                <columnExists tableName="customer" columnName="role"/>
            </not>
        </preConditions>

        <addColumn tableName="customer">
            <column name="role" type="varchar" remarks="role" defaultValue="USER">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="customer">
                <column name="role"/>
            </dropColumn>
        </rollback>
    </changeSet>
</databaseChangeLog>
