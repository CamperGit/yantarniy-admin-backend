<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet id="content_tables_usr_create_2024-08-07_15:00" author="Camper">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="user_role"/>
            </not>
        </preConditions>
        <createTable tableName="user_role" remarks="user_role">
            <column name="id" type="BIGINT" remarks="id" defaultValue="nextval('user_role_id_seq')">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR" remarks="title">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="user_role"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
